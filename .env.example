# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# development | production | testing (python run.py reads this; gunicorn passes it explicitly)
APP_ENV=development

# Not used by any feature yet. Set a long random value in production anyway:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Future AI features. When either is true, the /api blueprint is registered.
# Both endpoints return 501 until they are implemented (see README roadmap).
ENABLE_CHAT=false
ENABLE_JD_MATCH=false

# Static export only: set when the site is served under a path prefix,
# for example a GitHub Pages project site.
# FREEZER_BASE_URL=https://your-handle.github.io/portfolio/

# Dev server
# HOST=127.0.0.1
# PORT=5000
